# Reference only: Spring Boot does not automatically load this file.
# Docker Compose DOES load the root .env file. start-docker.ps1 creates it with
# random local database credentials on first use. Do not commit that file.
# MYSQL_PASSWORD=<random app database password>
# MYSQL_ROOT_PASSWORD=<different random root database password>
# APP_PORT=8080
# Set these environment variables in the shell that starts the backend.
SPRING_DATASOURCE_USERNAME=renewiq_app
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-password
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional deployment-specific JDBC URL (use the TLS settings required by your host).
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/renewiq_db?serverTimezone=UTC
# Alternative AI provider: configure AI_API_KEY, AI_BASE_URL and AI_MODEL together.

# Renewal emails (disabled until an SMTP account is configured)
REMINDER_EMAIL_ENABLED=false
REMINDER_FROM=reminders@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
REMINDER_TIMEZONE=Asia/Kolkata
# Spring cron: second minute hour day month weekday
REMINDER_CRON=0 0 9 * * *
